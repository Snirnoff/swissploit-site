{
  "name": "swissploit-site",
  "private": true,
  "type": "module",
  "scripts": {
    "build:posts": "node scripts/build-posts.mjs",
    "test:videos": "node scripts/youtube-shorts.mjs && node --test scripts/youtube-shorts.test.mjs",
    "check:seo": "node scripts/check-seo.mjs",
    "test": "node --test scripts/*.test.mjs",
    "build:headers": "node scripts/sync-headers.mjs",
    "check:headers": "node scripts/sync-headers.mjs --check",
    "build": "npm run build:posts && npm run build:headers",
    "check:motion": "node scripts/check-motion-browser.mjs"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "marked": "^13.0.3",
    "fast-glob": "^3.3.2"
  }
}
